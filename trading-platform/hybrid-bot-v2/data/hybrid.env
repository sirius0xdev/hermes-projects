# Hybrid Bot v2 env — P0/P1 filters + HL context gates
# Paper-safe defaults. To go LIVE: HYB_DRY_RUN=false + HYB_ALLOW_LIVE=1 + bump HYB_SESSION.

# --- Mode ---
HYB_DRY_RUN=false
HYB_ALLOW_LIVE=1
HYB_TESTNET=false

# --- Universe ---
HYB_COINS=BTC,xyz:GOLD
HYB_SESSION=hybrid-live-20260725-p1

# --- Fade policy ---
# off | lower_only | all
HYB_FADE_MODE=lower_only

# --- HL context refresh ---
HYB_CTX_ENABLED=1
HYB_CTX_REFRESH_SEC=30

# --- Liquidity floors (USD day notional) ---
HYB_MIN_DAY_NTL_BTC=500000000
HYB_MIN_DAY_NTL_HIP3=5000000
HYB_MIN_DAY_NTL_DEFAULT=10000000

# --- Funding gates (rate as decimal, e.g. 1.25e-5) ---
HYB_FUNDING_GATE=1
# Block LONG if funding > +thr (longs crowded); SHORT if funding < -thr
HYB_FUNDING_LONG_MAX=0.00005
HYB_FUNDING_SHORT_MIN=-0.00005
# If 1, apply funding gate to all setups; if 0, fades only
HYB_FUNDING_GATE_TREND=0

# --- OI gates ---
HYB_OI_GATE=1
# If OI increased by this fraction since last snapshot, block upper_band SHORT fade
HYB_OI_RISE_FADE_BLOCK=0.003

# --- Microstructure (maker quality) ---
HYB_BASIS_GATE=1
HYB_MAX_BASIS=0.0015
HYB_IMPACT_GATE=1
HYB_MAX_IMPACT_SPREAD=0.0008
# When basis/impact fail: skip_maker | skip_entry
HYB_MICRO_FAIL_MODE=skip_maker

# --- Risk locks (unchanged from v1) ---
HYB_SIZING_MODE=full_port
HYB_PORT_FRACTION=0.90
HYB_MAX_OPEN=1
HYB_MAX_LEVERAGE=50
HYB_USE_MAX_LEV=1
HYB_MAKER=1
HYB_MAKER_FILL_TIMEOUT=20
HYB_SL_ROE=0.07
HYB_TP_ROE=0.15

# --- Telegram (live-only by default) ---
HYB_TELEGRAM=1
HYB_TELEGRAM_PAPER=0

HYB_LOG_LEVEL=INFO

# --- Operator go-live override (same as hybrid-live-20260724): readiness bar zeroed ---
HYB_MIN_CLOSED_TRADES=0
HYB_MIN_WIN_RATE=0
HYB_MIN_PF=0
